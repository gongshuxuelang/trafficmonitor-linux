{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure debug",
            "detail": "配置 build/debug（Ninja、Debug、导出 compile_commands.json）",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".",
                "-B", "build/debug",
                "-G", "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: build debug",
            "detail": "构建 build/debug 下的全部目标",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build/debug", "-j"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: configure debug",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMake: test debug",
            "detail": "运行 build/debug 下的全部 ctest 测试",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir", "build/debug", "--output-on-failure"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: build debug",
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}
