#!/bin/sh

# TrafficMonitor for Linux launcher.
# GNOME/Wayland does not let a normal Qt client position or pin its own window,
# so the Qt overlay uses XWayland unless the user explicitly chooses a platform.
if [ "${XDG_SESSION_TYPE:-}" = "wayland" ] && [ -z "${QT_QPA_PLATFORM:-}" ]; then
    export QT_QPA_PLATFORM=xcb
fi

if [ -z "${TRAFFICMONITOR_PLUGIN_DIR:-}" ] && [ -d /usr/lib/trafficmonitor-linux/plugins ]; then
    export TRAFFICMONITOR_PLUGIN_DIR=/usr/lib/trafficmonitor-linux/plugins
fi

# 离线包会带这些目录；在线包没有，判断后跳过。
if [ -d /usr/lib/trafficmonitor-linux/lib ]; then
    export LD_LIBRARY_PATH="/usr/lib/trafficmonitor-linux/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
if [ -d /usr/lib/trafficmonitor-linux/qt-plugins ]; then
    export QT_PLUGIN_PATH="/usr/lib/trafficmonitor-linux/qt-plugins${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
    export QT_QPA_PLATFORM_PLUGIN_PATH=/usr/lib/trafficmonitor-linux/qt-plugins/platforms
fi

exec trafficmonitor-linux "$@"
